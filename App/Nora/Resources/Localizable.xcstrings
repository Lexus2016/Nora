          }
        }
      }
    },
    "Removes old delivered notifications to keep their database small.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет старые доставленные уведомления, чтобы их база не разрасталась."
