{
  "sourceLanguage": "en",
  "strings": {
    "%.1f GB": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%.1f ГБ"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%.1f ГБ"
          }
        }
      }
    },
    "%@ above %@ for %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ выше %@ в течение %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ вище %@ протягом %@"
          }
        }
      }
    },
    "%@ changed since the scan. Scan again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ изменился после сканирования. Просканируйте снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ змінився після сканування. Скануйте знову."
          }
        }
      }
    },
    "%@ free": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ свободно"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ вільно"
          }
        }
      }
    },
    "%@ has used %@ h of processor time in %@ h of running (about %@%%)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ использовал %@ ч процессорного времени за %@ ч работы (около %@%%)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ використав %@ год процесорного часу за %@ год роботи (близько %@%%)"
          }
        }
      }
    },
    "%@ is no longer in Mole's list. Scan again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ больше нет в списке Mole. Просканируйте снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ більше немає в списку Mole. Скануйте знову."
          }
        }
      }
    },
    "%@ is no longer in quarantine.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ больше не в карантине."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ більше не в карантині."
          }
        }
      }
    },
    "%@ is now listed from another folder (%@). Scan again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ теперь найден в другой папке (%@). Просканируйте снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ тепер знайдено в іншій теці (%@). Скануйте знову."
          }
        }
      }
    },
    "%@ is owned by the system. Nora does not change it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ принадлежит системе. Nora его не меняет."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ належить системі. Nora його не змінює."
          }
        }
      }
    },
    "%@ is still outdated": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ всё ещё не обновлено"
          }
        },
        "uk": {
