        "ru": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld снятые позиции будут временно защищены на время запуска. Кэши и журналы удаляются окончательно; программы создадут их заново."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld снятых позиций будет временно защищено на время запуска. Кэши и журналы удаляются окончательно; программы создадут их заново."
                }
              },
              "one": {
