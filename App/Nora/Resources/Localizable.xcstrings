          }
        }
      }
    },
    "Nora follows your Mac's language: English, Ukrainian or Russian. Change it per app in System Settings → General → Language & Region → Applications.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Nora использует язык вашего Mac: английский, украинский или русский. Для отдельных программ его можно изменить в Системных настройках → Основные → Язык и регион → Программы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nora використовує мову вашого Mac: англійську, українську або російську. Для окремих програм її можна змінити в Системних параметрах → Загальні → Мова та регіон → Програми."
          }
        }
      }
    },
    "Nora found %@, but it did not run: %@": {
      "localizations": {
        "ru": {
