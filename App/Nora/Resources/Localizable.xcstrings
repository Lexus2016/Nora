    "%lld unchecked items stay protected for this run. Caches and logs are deleted permanently; apps recreate them.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld unchecked item stays protected for this run. Caches and logs are deleted permanently; apps recreate them."
                }
              },
              "other": {
