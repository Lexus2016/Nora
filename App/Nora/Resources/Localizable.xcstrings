            "value": "Стоп"
          }
        }
      }
    },
    "Stopped": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановлено"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зупинено"
          }
        }
      }
    },
    "Stopped. Files removed before the stop stay removed.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановлено. Файлы, удалённые до остановки, остаются удалёнными."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зупинено. Файли, видалені до зупинки, лишаються видаленими."
          }
        }
      }
    },
    "Stopped. The items that were not moved stay ticked.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановлено. Объекты, которые не перемещены, остаются отмеченными."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зупинено. Об’єкти, які не перемістили, лишаються позначеними."
          }
        }
      }
    },
    "Stopping": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Останавливаю"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зупиняю"
          }
        }
      }
    },
    "Stops Finder from writing .DS_Store files on network and USB drives.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрещает Finder создавать файлы .DS_Store на сетевых и USB-дисках."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Забороняє Finder створювати файли .DS_Store на мережевих і USB-дисках."
          }
        }
      }
    },
    "Swap": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Swap"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Своп"
          }
        }
      }
    },
    "Swap %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Swap %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Своп %@"
          }
        }
      }
    },
    "Swap fills when memory was short earlier. It empties as the apps holding it quit, or after a restart.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Swap заполняется, когда раньше не хватало памяти. Он освобождается, когда программы, которые его занимают, закрываются, или после перезагрузки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Своп заповнюється, коли раніше бракувало пам’яті. Він звільняється, коли програми, що його займають, закриваються, або після перезавантаження."
          }
        }
      }
    },
    "System Status": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Состояние системы"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стан системи"
          }
        }
      }
    },
    "System caches are not included. They need your password.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системные кэши не включены. Для них нужен пароль."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Системні кеші не включено. Для них потрібен пароль."
          }
        }
      }
    },
    "System power": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системное питание"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Системне живлення"
          }
        }
      }
    },
    "System power (Mole)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системное питание (Mole)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Системне живлення (Mole)"
          }
        }
      }
    },
    "System-wide caches and logs. Needs your password.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Общесистемные кэши и журналы. Нужен пароль."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Загальносистемні кеші та журнали. Потрібен пароль."
          }
        }
      }
    },
    "Tab completion for mo in your shell. Nora shows the line it adds first.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автодополнение по Tab для mo в вашей оболочке. Nora сначала показывает строку, которую добавляет."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автодоповнення Tab для mo у вашій оболонці. Nora спершу показує рядок, який додає."
          }
        }
      }
    },
    "Tasks are ready. Here is what we found:": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задачи готовы. Вот что мы нашли:"
